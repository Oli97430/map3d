    "@sentry/react": "^10.53.1",
    "@types/three": "^0.173.0",
    "axios": "^1.7.9",
    "deventds2": "^0.1.10",
    "i18next": "^26.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "postprocessing": "^6.39.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.7",
    "react-leaflet": "^5.0.0",
    "three": "^0.173.0",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.3"
